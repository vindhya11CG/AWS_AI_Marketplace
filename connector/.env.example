# =============================================================================
# AWS Marketplace Connector & Pipeline Configuration
# =============================================================================

# S3 Destination Bucket and Keys for Curated Catalogs
CURATED_BUCKET=ai-marketplace-624807913752-us-east-1-an
CURATED_KEY_STARTER_PACKS=curated/starter-packs.json
CURATED_KEY_AGENTS=curated/agents.json
CURATED_KEY_CATALOG=curated/marketplace-catalog.json

# S3 Raw Audit Prefix (Incoming exports land here)
RAW_PREFIX=raw/

# Mandatory Team & Billing Tag
RESOURCE_TAG=aep_aws

# AWS Region & Lambda Deployment Config
AWS_REGION=us-east-1
LAMBDA_FUNCTION_NAME=ai-marketplace-transform
IAM_ROLE_NAME=ai-marketplace-transform-role

# API Gateway Ingestion & Query Endpoint (Generated after deployment)
# E.g.: https://yymryxj4se.execute-api.us-east-1.amazonaws.com/prod
API_GATEWAY_URL=https://yymryxj4se.execute-api.us-east-1.amazonaws.com/prod

# Optional: Direct Microsoft Graph API Credentials (for /sync-graph endpoint)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SITE_ID=capgemini.sharepoint.com,sites/KnowNow,AIMarketplace
