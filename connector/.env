# ==========================================
# Lambda Transform & S3 Connector Configuration
# ==========================================

# S3 Destination Bucket and Curated Catalog Key
CURATED_BUCKET=ai-marketplace-624807913752-us-east-1-an
CURATED_KEY=curated/starter-packs.json

# S3 Raw Backup Prefix (Audit trail)
RAW_PREFIX=raw/

# Mandatory Team / Billing Tag
RESOURCE_TAG=aep_aws

# AWS Deployment Region
AWS_REGION=us-east-1

# API Gateway Ingestion Endpoint (Proxy for Azure Logic App / Webhook)
# Endpoint URL generated after deploying API Gateway REST API:
INGESTION_API_URL=https://yymryxj4se.execute-api.us-east-1.amazonaws.com/prod/transform

# SharePoint site + list (defaults already match your KnowNow site)
SP_HOSTNAME=capgemini.sharepoint.com
SP_SITE_PATH=/sites/KnowNow/AIMarketplace
SP_LIST_NAME=Industrialized Use cases
 
# AWS S3 destination
S3_BUCKET=ai-marketplace-624807913752-us-east-1-an
S3_KEY=sharepoint-list.json
AWS_REGION=us-east-1
RESOURCE_TAG=aep_aws
 
# AWS credentials: EITHER set them here OR use an AWS CLI profile (aws configure).
# If you use a profile, leave these blank.
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
