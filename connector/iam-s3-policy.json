{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteRawZone",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::ai-marketplace-624807913752-us-east-1-an/raw/*"
    },
    {
      "Sid": "ReadWriteCuratedZone",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::ai-marketplace-624807913752-us-east-1-an/curated/*"
    },
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::ai-marketplace-624807913752-us-east-1-an"
    }
  ]
}
