# ==========================================
# Frontend Environment Configuration (Vite + React)
# ==========================================

# URL of the live catalog published by the pipeline (S3 Curated JSON or CloudFront CDN).
# If left empty, the application gracefully falls back to the bundled offline dataset.
#
# Option A: Direct S3 URL (Requires S3 CORS configuration):
VITE_CATALOG_URL=https://ai-marketplace-624807913752-us-east-1-an.s3.amazonaws.com/curated/starter-packs.json
#
# Option B: Amazon CloudFront Distribution URL (Recommended for production):
# VITE_CATALOG_URL=https://d111111abcdef8.cloudfront.net/curated/starter-packs.json
